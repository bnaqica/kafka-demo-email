# Lombok settings for this repo. See https://projectlombok.org/features/configuration
config.stopBubbling = true

# Marks generated code with @lombok.Generated so coverage tools skip it
lombok.addLombokGeneratedAnnotation = true

# @Slf4j field name used everywhere: log.info(...)
lombok.log.fieldName = log

# Carry these onto constructor parameters generated by @RequiredArgsConstructor
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
